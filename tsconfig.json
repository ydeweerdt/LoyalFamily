{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": true,
		"sourceMap": true,
		"types": ["vite/client", "$app/types"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"],
	"exclude": ["node_modules", "build", ".svelte-kit"]
}
